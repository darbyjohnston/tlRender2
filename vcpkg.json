{
  "name": "tlrender2",
  "version": "2.0.0",
  "dependencies": [
    {
      "name": "sdl2",
      "default-features": false,
      "features": [
        {
          "name": "x11",
          "platform": "!windows"
        }
      ]
    },
    "nlohmann-json",
    "freetype",
    "lunasvg",
    "libpng",
    "ffmpeg",
    {
      "name": "minizip-ng",
      "default-features": false,
      "features": ["zlib"]
    },
    {
      "name": "openexr",
      "default-features": false
    },
    {
      "name": "openimageio",
      "default-features": false
    },
    {
      "name": "opencolorio",
      "default-features": false
    }
  ]
}
